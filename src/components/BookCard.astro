---
import { Image } from "astro:assets";

import mixedRootsThumb from "../assets/mixed-roots_thumb.jpg";
---

<!-- card -->
<li class="flex flex-col gap-6 sm:flex-row items-start sm:justify-between">
  <div class="flex flex-col gap-4 sm:flex-row sm:gap-6">
    <!-- image -->
    <div class="w-full max-w-36 overflow-clip shadow-md">
      <Image
        src={mixedRootsThumb}
        alt="Mixed Roots bookcover"
        class="object-cover w-full h-full"
      />
    </div>
    <!-- content -->
    <div class="space-y-2 md:space-y-3">
      <h3 class="text-2xl md:text-3xl font-playfair">Mixed Roots</h3>
      <p class="text-sm">2026</p>
      <p class="max-w-prose leading-relaxed text-zinc-600">
        A powerful anthology combining personal narratives with
        community-oriented perspectives, Mixed Roots features my
        essay, "Learning a Second Language."
      </p>
    </div>
  </div>
  <!-- buy link -->
  <a
    href=""
    class="py-1.5 px-3 uppercase tracking-widest inline-flex gap-1 items-center justify-center border border-neutral-300 hover:text-accent hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors"
    >Buy
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
      ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
        points="12 5 19 12 12 19"></polyline></svg
    >
  </a>
</li>
