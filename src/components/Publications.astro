---
import BookCard from "./BookCard.astro";
---

<section class="py-10 lg:py-24">
  <!-- wrapper -->
  <div class="mx-auto max-w-6xl px-4">
    <!-- inner wrapper -->
    <div class="space-y-8 md:space-y-12">
      <h2
        class="text-3xl md:text-4xl font-playfair font-light tracking-wide">
        Publications
      </h2>
      <!-- publications wrapper -->
      <div class="grid">
        <BookCard />
      </div>
    </div>
  </div>
  <!-- temp div -->
  <div class="py-96"></div>
</section>
