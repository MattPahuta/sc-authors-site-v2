---
import { Image } from "astro:assets";

import mixedRootsImage from "../assets/mixed-roots_thumb.jpg";
import emblazonImage from "../assets/emblazon_thumb.jpg";
import nonwhiteWomanImage from "../assets/nonwhite-woman_thumb.jpg";
import covidMonoImage from "../assets/covid-mono_thumb.jpg";

const publications = [
  {
    title: "Mixed Roots",
    year: 2026,
    description:
      'A powerful anthology combining personal narratives with community-oriented perspectives, Mixed Roots features my essay, "Learning a Second Language".',
    image: mixedRootsImage,
    imageAlt: "Mixed Roots bookcover",
    url: "https://bookshop.org/a/14863/9780807021361",
  },
  {
    title: "Yellow Arrow Journal, Emblazon",
    year: 2023,
    description:
      'Poetry, creative nonfiction, and cover art on the theme of EMBLAZON by writers and artists who identify as women. This volume features my piece, "End Credits".',
    image: emblazonImage,
    imageAlt: "Yellow Arrow Journal bookcover",
    url: "https://bookshop.org/a/14863/9798988317609",
  },
  {
    title: "Nonwhite and Woman",
    year: 2022,
    description:
      'This IPPY award-winning anthology features 131 microessays by and about women of color, featuring my essay "Mother Tongue".',
    image: nonwhiteWomanImage,
    imageAlt: "Nonwhite and Woman bookcover",
    url: "https://bookshop.org/a/14863/9781949116694",
  },
  {
    title: "The COVID Monologues",
    year: 2022,
    description:
      '54 writers create a living altar to the lives lost to COVID-19, including my piece, "The Blue Moon".',
    image: covidMonoImage,
    imageAlt: "The COVID Monologues bookcover",
    url: "https://bookshop.org/a/14863/9798809306058",
  },
];
---

<section id="publications" class="py-10 lg:py-24">
  <!-- wrapper -->
  <div class="mx-auto max-w-5xl px-4 sm:px-5">
    <!-- inner wrapper -->
    <div class="space-y-10 md:space-y-12">
      <h2 class="text-3xl md:text-4xl font-playfair tracking-wide">
        Publications
      </h2>
      <!-- Featured item - latest book -->
      <article class="p-8 bg-stone-100 rounded-sm shadow-lg">
        <div
          class="grid sm:grid-cols-[auto_1fr] gap-8 md:gap-12 items-start">
          <div class="w-36 md:w-44 overflow-clip shadow-md">
            <Image
              src={publications[0].image}
              alt={publications[0].imageAlt}
              class="w-full h-full object-cover aspect-auto"
            />
          </div>
          <div class="space-y-2 md:space-y-3">
            <div class="flex gap-3 items-center">
              <span class="text-xs uppercase text-accent">Latest</span
              >
              <span class="text-sm text-zinc-700"
                >{publications[0].year}</span
              >
            </div>
            <h3 class="text-2xl sm:text-3xl font-playfair">
              {publications[0].title}
            </h3>
            <p class="max-w-prose leading-relaxed text-zinc-600">
              {publications[0].description}
            </p>
            <a
              href={publications[0].url}
              target="_blank"
              class="mt-6 py-1.5 px-4 text-sm uppercase tracking-widest inline-flex gap-2 items-center justify-center hover:text-accent hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors">
              Buy the book
              <svg
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-3 sm:size-4">
                <>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </>
              </svg>
            </a>
          </div>
        </div>
      </article>
      <ul class="divide-y divide-neutral-300">
        {
          publications.slice(1).map((pub) => (
            <li class="py-8 flex flex-col gap-6 sm:flex-row items-start sm:justify-between">
              <div class="flex flex-col gap-4 sm:flex-row sm:gap-6">
                <div class="w-full max-w-30 overflow-clip shadow-md">
                  <Image
                    src={pub.image}
                    alt={pub.imageAlt}
                    class="object-cover w-30 h-44 aspect-auto"
                  />
                </div>
                <div class="space-y-2 md:space-y-3">
                  <h3 class="text-xl sm:text-2xl font-playfair">
                    {pub.title}
                  </h3>
                  <p class="text-sm">{pub.year}</p>
                  <p class="max-w-prose leading-relaxed text-zinc-600">
                    {pub.description}
                  </p>
                </div>
              </div>
              <a
                href={pub.url}
                target="_blank"
                class="py-1.5 px-3 text-sm uppercase tracking-widest inline-flex gap-1 items-center justify-center border border-neutral-300 hover:text-accent hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors">
                Buy
                <svg
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-3">
                  <>
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
