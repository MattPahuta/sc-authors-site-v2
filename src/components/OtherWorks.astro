---
import { Image } from "astro:assets";
import otherWritingImage from "../assets/other-writing.webp";
const otherWritingImageAlt =
  "An open laptop computer on a desk next to a window along with note paper and pens, a coffee mug in the foreground, and a view of trees and water on a sunny day.";

const otherWorks = [
  {
    title: "To The Nurse in the COVID ICU Ward",
    publication: "Months To Years",
    description: "A caring stranger makes a profound difference.",
    url: "https://monthstoyears.org/to-the-nurse-in-the-covid-icu-ward/",
  },
  {
    title: "Dark Ink",
    publication: "Latin@ Literatures",
    description: "May his memory be a blessing.",
    url: "https://www.latinoliteratures.org/archives/1771",
  },
  {
    title: "The Chorus and The Refrain",
    publication: "Lavender Bones",
    description: "Love and memory returns through music.",
  },
  {
    title: "Stealing Spanish",
    publication: "Alebrijes Review",
    description: "Sharing a vernacular with your favorite person.",
  },
];
---

<section id="otherWriting" class="py-10 lg:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-5">
    <h2
      class="mb-12 text-3xl md:text-4xl font-playfair tracking-wide">
      Other Writing
    </h2>
    <div class="grid gap-14 md:gap-20 items-start md:grid-cols-2">
      <div
        class="w-full max-w-87.5 lg:max-w-100 justify-self-center md:order-2 aspect-3/4 bg-stone-100 border border-neutral-300 overflow-hidden shadow-lg">
        <Image
          src={otherWritingImage}
          alt={otherWritingImageAlt}
          width="450"
          height="600"
          class="object-cover w-full h-full"
        />
      </div>
      <ul>
        {
          otherWorks.map((work) => (
            <li class="py-6 space-y-3 border-b border-neutral-300 first:border-t first:border-neutral-300">
              <h3 class="text-lg font-playfair">
                {work.url ? (
                  <a
                    href={work.url}
                    target="_blank"
                    class="hover:text-accent focus-visible:outline-2 focus-visible:outline-accent transition-colors">
                    {work.title}
                  </a>
                ) : (
                  work.title
                )}
              </h3>
              <p class="text-xs uppercase">{work.publication}</p>
              <p class="text-sm">{work.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
