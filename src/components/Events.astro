---
import FeaturedEvent from "./FeaturedEvent.astro";

const otherEvents = [
  {
    name: "Reading, Third Place Books",
    description: "Anne Liu Kellor and guests present 'Mixed Roots'",
    year: 2026,
  },
  {
    name: "Panelist, AWP Conference 2024",
    description: `“Snap, Crackle, Prose: Telling Our Stories in 300 Words or Less” and “Latina/o/x Narratives: Including Diverse Experiences From Our Community”`,
    year: 2024,
  },
  {
    name: "Writers on Writing",
    description:
      'Featured <a href="https://www.yellowarrowpublishing.com/writersonwriting/samantha-chagollan" target="_blank" class="text-accent hover:text-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition">interview</a> and <a href="https://www.youtube.com/watch?v=5ciOnwPnCn4" target="_blank" class="text-accent hover:text-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition">reading</a>, <span class="italic">Yellow Arrow Journal</span>',
    year: 2024,
  },
  {
    name: "Reading, Diné College Creative Writing",
    description: `<a href="https://www.youtube.com/watch?v=8qBIF6OK6H0" target="_blank" class="text-accent hover:text-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition">Virtual reading</a> of <span class="italic">Nonwhite and Woman</span>`,
    year: 2023,
  },
];
---

<section id="events" class="py-10 lg:py-24 bg-stone-100">
  <div class="mx-auto max-w-5xl px-4 sm:px-5">
    <div class="space-y-10 md:space-y-16">
      <h2 class="text-3xl md:text-4xl font-playfair tracking-wide">
        Events
      </h2>
      <ul
        class="space-y-10 md:space-y-16 divide-y divide-neutral-300" role="list">
        {
          otherEvents.map((event) => (
            <li class="pb-10 space-y-6 flex flex-col md:flex-row md:gap-8 lg:gap-10">
              <span class="mb-5 text-sm uppercase text-zinc-600">
                {event.year}
              </span>
              <div class="">
                <h3 class="mb-2 text-lg sm:text-xl font-playfair">
                  {event.name}
                </h3>
                <p
                  set:html={event.description}
                  class="max-w-prose text-sm leading-relaxed"
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
