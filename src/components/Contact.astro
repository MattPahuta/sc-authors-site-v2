<section id="contact" class="py-10 lg:py-24 bg-stone-100">
  <!-- wrapper div -->
  <div class="mx-auto max-w-6xl px-4 sm:px-5 space-y-6">
    <p class="text-sm uppercase text-accent">Get in touch</p>
    <h2
      class="text-2xl md:text-3xl font-semibold font-playfair tracking-wide">
      Connect with Samantha
    </h2>

    <div class="grid gap-10 sm:grid-cols-2">
      <!-- contact content -->
      <div>
        <p class="mb-6 max-w-[48ch] text-zinc-600">
          For reading engagements, speaking or panel requests, please
          reach out here:
        </p>
        <!-- contact list -->
        <dl class="mb-4 flex flex-col gap-4">
          <div>
            <dt class="text-xs uppercase mb-1">Email</dt>
            <dd class="">
              <a
                href="mailto:sam@samanthachagollan.com"
                class="hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
                >sam@samanthachagollan.com</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase mb-1">Phone</dt>
            <dd class="">
              <a
                href="tel:+19494785537"
                class="hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
                >(949) 478-5537</a
              >
            </dd>
          </div>
        </dl>
        <!-- socials list container -->
        <div>
          <h3 class="text-xs uppercase mb-1">Social</h3>
          <ul class="flex gap-4">
            <li class="">
              <a
                href="https://www.instagram.com/samchagollan/"
                class="hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
                >Instagram</a
              >
            </li>
            <li class="">
              <a
                href=""
                class="hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
                >LinkedIn</a
              >
            </li>
            <li class="">
              <a
                href=""
                class="hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
                >Goodreads</a
              >
            </li>
          </ul>
        </div>
      </div>
      <div class="space-y-6 text-zinc-600">
        <!-- <h3 class="text-sm uppercase text-accent">Storytelling</h3> -->
        <p class="max-w-prose">
          <a
            href=""
            target="_blank"
            class="font-semibold hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
            >Purple Ink Creative</a
          > is my marketing business, where I offer copywriting, editing
          and marketing strategy to medium and large businesses.
        </p>
        <p class="max-w-prose">
          <a
            href=""
            target="_blank"
            class="font-semibold hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent transition"
            >The Restless Raconteur</a
          > is a blog about creative exploration for adventurous souls.
        </p>
      </div>
    </div>
  </div>

