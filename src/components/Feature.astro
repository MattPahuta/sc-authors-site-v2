---
import { Image } from "astro:assets";
import featuredImage from "../assets/mixed-roots.jpg";
const featuredBuyURL = "https://bookshop.org/a/14863/9780807021361";
const imageAlt = "Mixed Roots bookcover";
import FeaturedEventBadge from "./FeaturedEventBadge.astro";
---

<!-- ToDo: replace border-bottom divier with Divider component -->
<section class="py-10 lg:py-24">
  <!-- wrapper container -->
  <div class="mx-auto max-w-5xl px-4 sm:px-5">
    <!-- grid container -->
    <div
      class="grid md:grid-cols-2 gap-12 md:px-7 md:pb-12 ">
      <!-- grid item - featured content -->
      <div class="space-y-6 md:space-y-10 flex flex-col">
        <p class="text-sm uppercase text-accent">Latest Book</p>
        <h2
          class="mb-5 text-5xl lg:text-6xl font-semibold font-playfair">
          Mixed Roots
        </h2>
        <p class="max-w-prose text-lg leading-relaxed text-zinc-600">
          A powerful anthology combining personal narratives with
          community-oriented perspectives, Mixed Roots features my
          essay, "Learning a Second Language."
        </p>
        <div class="flex gap-5">
          <a
            href={featuredBuyURL}
            target="_blank"
            class="text-sm uppercase hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
            >Buy the book</a
          >
          <a
            href=""
            class="text-sm uppercase hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
            >All Works</a
          >
        </div>
      </div>
      <!-- grid item - featured image -->
      <div
        class="relative flex items-center justify-center md:justify-end">
        <div class="relative width-full max-w-85 shadow-lg">
          <Image
            src={featuredImage}
            alt={imageAlt}
            class="object-cover w-full h-full"
          />
          <!-- Event badge -->
          <FeaturedEventBadge />
        </div>
      </div>
    </div>
  </div>
</section>
