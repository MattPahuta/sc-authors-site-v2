---
import { Image } from "astro:assets";
import featuredImage from "../assets/mixed-roots.jpg";

const imageAlt = "Mixed Roots bookcover";
---

<section class="py-10">
  <!-- wrapper container -->
  <div class="mx-auto max-w-6xl">
    <!-- grid container -->
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16">
      <!-- grid item - featured content -->
      <div class="flex flex-col">
        <p class="uppercase">Latest Book</p>
        <h2 class="mb-5 text-6xl font-semibold font-playfair">Mixed Roots</h2>
        <p class="text-lg leading-relaxed text-zinc-600">
          A powerful anthology combining personal narratives with
          community-oriented perspectives, Mixed Roots features my
          essay, "Learning a Second Language."
        </p>
      </div>
      <!-- grid item - featured image -->
      <div class="text-lg leading-relaxed text-zinc-600">
        <div class="relative overflow-hidden aspect-3/4 width-full max-w-[400px] shadow-sm">
          <Image src={featuredImage} alt={imageAlt} class="object-cover w-full h-full" />
        </div>
      </div>
    </div>
  </div>
</section>
