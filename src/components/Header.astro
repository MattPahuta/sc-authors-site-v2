---
const navMenuItems = [
  { label: "About", href: "#about" },
  { label: "Publications", href: "#publications" },
  { label: "Events", href: "#events" },
  { label: "Other Writing", href: "#otherWriting" },
  { label: "Contact", href: "#contact" },
];
---

<header class="py-5 border-b border-neutral-300">
  <div id="wrapper" class="max-w-5xl mx-auto px-4">
    <div
      id="site-header__inner"
      class="flex flex-col gap-5 md:flex-row items-center justify-between">
      <h1 class="text-2xl text-zinc-800 font-playfair tracking-wide">
        Samantha Chagollan
      </h1>
      <nav id="primary-nav" class="">
        <ul
          class="max-w-75 md:max-w-full tracking-wide flex items-center justify-center gap-y-2 gap-x-3 lg:gap-5 flex-wrap">
          {
            navMenuItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
