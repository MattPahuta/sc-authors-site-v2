---
import { Image } from "astro:assets";
import profileImage from "../assets/sc-headshot_v1.jpg";
const profileImageAlt = "Samantha Chagollan headshot";
import profileImage2 from "../assets/sc-profile-02.jpg";
const profileImage2Alt =
  "Samantha Chagollan standing in a lush coastal forest";

import NextEventBadge from "./NextEventBadge.astro";
---

<section id="about" class="py-10 lg:py-24">
  <!-- wrapper container -->
  <div class="mx-auto max-w-5xl px-4 sm:px-5">
    <!-- grid container -->
    <div class="grid gap-6 md:grid-cols-[auto_1fr] items-start">
      <!-- grid item - featured image -->
      <div class="max-w-75 md:max-w-87.5 lg:max-w-93.75 overflow-hidden shadow-lg">
        <Image
          src={profileImage2}
          alt={profileImage2Alt}
          class="object-cover w-full h-full"
        />
      </div>
      <!-- grid item - featured content -->
      <div class="space-y-6 md:space-y-10 flex flex-col lg:px-12">
        <p class="text-sm uppercase tracking-wide text-accent">
          About
        </p>
        <h2
          class="mb-5 text-2xl md:text-3xl font-semibold font-playfair tracking-wide">
          Samantha Chagollan
        </h2>
        <p class="max-w-prose text-lg leading-relaxed text-zinc-600">
          Samantha Chagollan is a writer and artist who centers much
          of her creative work around the themes of home, family, and
          her mixed Mexican and American heritage. She earned a
          bachelor's degree in English from Cal Poly Humboldt, where
          she focused on multicultural literature.
        </p>
        <p class="max-w-prose text-lg leading-relaxed text-zinc-600">
          She has written dozens of books for children and teens, and
          her creative nonfiction has also been featured in a number
          of literary journals and in the award-winning anthologies
          The COVID Monologues and Nonwhite and Woman. She lives in
          Southern California, where she is currently working on her
          first memoir, Homesick.
        </p>
      </div>

      <!-- next event badge -->
      <div class="md:row-start-2">
        <NextEventBadge />
      </div>
    </div>
  </div>
</section>
