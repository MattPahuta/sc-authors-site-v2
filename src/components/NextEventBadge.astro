---
const eventVenue = "Third Place Books";
const eventDate = "Oct 15";
const eventLocation = "Lake Forest Park";
---

<a
  href="#events"
  class="group mt-6 w-full sm:w-max flex items-center p-3 sm:py-4 sm:px-5 border border-neutral-300 bg-stone-100 shadow-sm hover:border-accent focus-visible:outline-2 -outline-offset-1 focus-visible:outline-accent transition">
  <div class="flex flex-col gap-3">
    <span class="text-xs uppercase text-zinc-600"
      >Next appearance</span
    >
    <p class="flex gap-3 flex-wrap items-center justify-start">
      <span class="font-playfair font-medium tracking-wide"
        >{eventVenue}</span
      >
      <span class="text-zinc-600 flex items-center"
        >{eventDate}
        <svg
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"><circle cx="12" cy="12" r="1"></circle></svg
        >
        {eventLocation}</span
      >
    </p>
  </div>
</a>
