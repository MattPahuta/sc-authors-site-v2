---
import "../styles/global.css";
import { Font } from "astro:assets";
const { title = "Samantha Chagollan" } = Astro.props;
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://samanthachagollan.com" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Samantha Chagollan is a writer and artist whose creative nonfiction explores memory, home, belonging, and her mixed Mexican-American heritage."
    />
    <meta
      property="og:image"
      content="https://samanthachagollan.com/sc-author.jpg"
    />
    <meta property="og:title" content="Samantha Chagollan | Writer and Artist" />
    <meta property="og:url" content="https://samanthachagollan.com" />
    <title>{title}</title>
    <Font cssVariable="--font-playfair" />
  </head>
  <body class="min-h-screen bg-stone-50 text-zinc-900">
    <slot />
  </body>
</html>
